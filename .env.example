# ============================================================
# AI Platform Docker Compose 环境变量模板
# 使用方式：复制为 .env 后按需修改；.env 已被 .gitignore 忽略
# ============================================================

# ----- Web -----
WEB_PORT=80
SERVER_PORT=8080

# ----- MySQL 8 -----
MYSQL_DATABASE=ai_platform
MYSQL_USERNAME=ai_platform
MYSQL_PASSWORD=AiPlatform@2026
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026

# ----- PostgreSQL + PGVector -----
POSTGRES_DB=ai_platform_vector
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=AiPlatformVector@2026

# ----- Redis -----
REDIS_PASSWORD=AiPlatformRedis@2026

# ----- 安全密钥（生产环境必须替换为随机值） -----
# JWT 密钥至少 32 字节；建议使用密码管理器生成 64 位随机字符串
AI_PLATFORM_JWT_SECRET=please-change-this-demo-jwt-secret-at-least-32-bytes-0123456789
# 模型 API Key 的服务端加密主密钥；P1 启用后用于 AES-GCM 加密
AI_PLATFORM_MASTER_KEY=please-change-this-demo-master-key-at-least-32-bytes
# 初始账号密码，首次登录会被强制修改；生产默认不创建/启用 demo 账号
AI_PLATFORM_ADMIN_PASSWORD=Admin@123456
AI_PLATFORM_DEMO_ENABLED=false
AI_PLATFORM_DEMO_PASSWORD=Demo@123456
# 面向 ERP 的开放接口，默认关闭；启用时必须设置随机 API Key
AI_PLATFORM_OPEN_API_ENABLED=false
AI_PLATFORM_OPEN_API_KEY=
# 图片地址识别兜底：本地 Tesseract OCR（需安装 tesseract 与 chi_sim 语言包）
AI_PLATFORM_OCR_ENABLED=true
AI_PLATFORM_OCR_TESSERACT_COMMAND=tesseract
AI_PLATFORM_OCR_TESSDATA_DIR=/app/data/tessdata
AI_PLATFORM_OCR_LANGUAGES=chi_sim+eng
AI_PLATFORM_OCR_TIMEOUT_SECONDS=60

# ----- 文件上传 -----
AI_PLATFORM_STORAGE_ROOT=/app/data/uploads
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=50MB

# ----- 日志 -----
LOG_LEVEL=INFO
